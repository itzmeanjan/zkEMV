// `head || tail`, as the ICC certificate hash uses it. The message is the one above (byte i is
// 3 + 7i mod 256); storage past the tail's length holds garbage, which must not be hashed.

fn pattern(i: u32) -> u8 {
    ((3 + 7 * i) % 256) as u8
}

fn words(digest: [u8; 20]) -> [Field; 5] {
    let mut out = [0; 5];
    for k in 0..5 {
        for i in 0..4 {
            out[k] = out[k] * 256 + digest[4 * k + i] as Field;
        }
    }
    out
}

fn check_head_tail<let P: u32, let S: u32>(len: u32, expected: [u8; 20]) {
    let mut head = [0; P];
    for i in 0..P {
        head[i] = pattern(i);
    }
    let mut storage = [0xAB; S];
    for i in 0..S {
        if i < len {
            storage[i] = pattern(P + i);
        }
    }
    let tail = BoundedVec::from_parts(storage, len);
    assert_eq(crate::sha1::digest_words_var(head, tail), words(expected));
}

#[test]
fn sha1_head_tail_empty() {
    check_head_tail::<219, 256>(
        0,
        [0x61, 0xf4, 0xcf, 0xf2, 0xe0, 0x7f, 0x76, 0x6e, 0x69, 0xce, 0x56, 0xc3, 0x53, 0x5c, 0xf9, 0x1a, 0x38, 0x7c, 0xf5, 0xf2],
    );
}

#[test]
fn sha1_head_tail_mastercard() {
    check_head_tail::<219, 256>(
        131,
        [0x8, 0x23, 0x6c, 0x56, 0xcb, 0xc4, 0xc5, 0x82, 0xe7, 0x80, 0xf5, 0xdc, 0xe7, 0x7c, 0xe9, 0x4d, 0x8d, 0x5a, 0x5, 0x64],
    );
}

#[test]
fn sha1_head_tail_full() {
    check_head_tail::<219, 256>(
        256,
        [0x69, 0xe3, 0x48, 0x4d, 0x6a, 0x9e, 0x31, 0xcc, 0x92, 0x28, 0x44, 0x37, 0xfb, 0x31, 0x41, 0x8b, 0x6b, 0xc5, 0x8b, 0x1b],
    );
}

// Total 283 = 4 * 64 + 27: the padding and length fit in the fifth block.
#[test]
fn sha1_head_tail_block_edge() {
    check_head_tail::<219, 256>(
        64,
        [0x72, 0xac, 0xf2, 0xc1, 0x9d, 0x36, 0xcc, 0xf9, 0x2a, 0xe8, 0xca, 0xfb, 0x7, 0x3c, 0x1e, 0x6c, 0x1, 0xcd, 0xc0, 0x3c],
    );
}

#[test]
fn sha1_head_tail_short_head() {
    check_head_tail::<100, 156>(
        127,
        [0x8e, 0x7c, 0x12, 0x17, 0x21, 0x50, 0xd0, 0x25, 0x68, 0x92, 0x48, 0xd9, 0xa4, 0xec, 0xbc, 0xa6, 0xfa, 0xc2, 0xcb, 0x19],
    );
}

#[test(should_fail)]
fn sha1_head_tail_wrong_length() {
    check_head_tail::<219, 256>(
        130,
        [0x8, 0x23, 0x6c, 0x56, 0xcb, 0xc4, 0xc5, 0x82, 0xe7, 0x80, 0xf5, 0xdc, 0xe7, 0x7c, 0xe9, 0x4d, 0x8d, 0x5a, 0x5, 0x64],
    );
}
