//! SHA-1 known answers: NIST FIPS 180 examples plus every padding boundary the
//! EMV hash inputs can land on (len mod 64 around 55/56/64). Expected values from
//! Python's hashlib. Both the fixed-length and the BoundedVec entry points are checked.

#[test]
fn sha1_empty() {
    let msg: [u8; 0] = [];
    let expected: [u8; 20] = [0xda, 0x39, 0xa3, 0xee, 0x5e, 0x6b, 0x4b, 0xd, 0x32, 0x55, 0xbf, 0xef, 0x95, 0x60, 0x18, 0x90, 0xaf, 0xd8, 0x7, 0x9];
    assert_eq(crate::sha1::digest(msg), expected);
    assert_eq(crate::sha1::digest_var(BoundedVec::<u8, 256>::from_array(msg)), expected);
}

#[test]
fn sha1_abc() {
    let msg: [u8; 3] = [0x61, 0x62, 0x63];
    let expected: [u8; 20] = [0xa9, 0x99, 0x3e, 0x36, 0x47, 0x6, 0x81, 0x6a, 0xba, 0x3e, 0x25, 0x71, 0x78, 0x50, 0xc2, 0x6c, 0x9c, 0xd0, 0xd8, 0x9d];
    assert_eq(crate::sha1::digest(msg), expected);
    assert_eq(crate::sha1::digest_var(BoundedVec::<u8, 256>::from_array(msg)), expected);
}

#[test]
fn sha1_nist448() {
    let msg: [u8; 56] = [
        0x61, 0x62, 0x63, 0x64, 0x62, 0x63, 0x64, 0x65, 0x63, 0x64, 0x65, 0x66, 0x64, 0x65, 0x66, 0x67, 0x65, 0x66, 0x67, 0x68, 0x66, 0x67, 0x68, 0x69, 0x67,
        0x68, 0x69, 0x6a, 0x68, 0x69, 0x6a, 0x6b, 0x69, 0x6a, 0x6b, 0x6c, 0x6a, 0x6b, 0x6c, 0x6d, 0x6b, 0x6c, 0x6d, 0x6e, 0x6c, 0x6d, 0x6e, 0x6f, 0x6d, 0x6e,
        0x6f, 0x70, 0x6e, 0x6f, 0x70, 0x71,
    ];
    let expected: [u8; 20] = [0x84, 0x98, 0x3e, 0x44, 0x1c, 0x3b, 0xd2, 0x6e, 0xba, 0xae, 0x4a, 0xa1, 0xf9, 0x51, 0x29, 0xe5, 0xe5, 0x46, 0x70, 0xf1];
    assert_eq(crate::sha1::digest(msg), expected);
    assert_eq(crate::sha1::digest_var(BoundedVec::<u8, 256>::from_array(msg)), expected);
}

#[test]
fn sha1_nist896() {
    let msg: [u8; 112] = [
        0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x64,
        0x65, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x6b, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x67, 0x68,
        0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f, 0x70, 0x6a, 0x6b, 0x6c,
        0x6d, 0x6e, 0x6f, 0x70, 0x71, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f, 0x70, 0x71, 0x72, 0x6c, 0x6d, 0x6e, 0x6f, 0x70, 0x71, 0x72, 0x73, 0x6d, 0x6e, 0x6f, 0x70,
        0x71, 0x72, 0x73, 0x74, 0x6e, 0x6f, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75,
