#[test(should_fail_with = "signature >= modulus")]
fn recover_doubled_rejects_signature_not_below_modulus() {
    // n <= sig < 2n: in range for the doubled arithmetic, but not a valid signature.
    let key: DoubledKey<17, 1921> = DoubledKey::from_be_bytes(
