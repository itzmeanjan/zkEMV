//! RSA recovery (`sig^3 mod n`) against Python's pow, on random odd moduli of the
//! exact widths the circuits use. Exponent-3 recovery needs no factorisation, so no
//! real key material is involved. Generated with random.Random(2609).

use crate::RsaKey;

#[test]
fn recover_1024() {
    let key = RsaKey::<128>::from_be_bytes([
        0xf9, 0x51, 0xb1, 0xc5, 0x7c, 0x76, 0xa5, 0x77, 0x50, 0x70, 0xa4, 0xa1, 0xfc, 0xdd, 0xc1, 0x11, 0x8, 0x1c, 0x38, 0x51, 0xc5, 0xa4, 0x8e, 0xc6, 0xd2,
        0x80, 0xa4, 0xdb, 0x1, 0xeb, 0xab, 0xde, 0x3f, 0x4d, 0x62, 0x7d, 0x84, 0x88, 0xed, 0x37, 0xf4, 0xcd, 0x21, 0x8f, 0x34, 0x51, 0xf8, 0x67, 0xb4, 0x1,
        0x25, 0x79, 0x80, 0x92, 0x70, 0x11, 0x6e, 0xa1, 0x9c, 0xa8, 0x36, 0x23, 0x7f, 0xca, 0x1, 0x2b, 0x5d, 0xb2, 0xa1, 0xeb, 0x53, 0xf4, 0xf2, 0x12, 0x11,
        0x3c, 0xe, 0xb0, 0x21, 0x77, 0x23, 0x7e, 0xa4, 0x62, 0xc3, 0xfe, 0x19, 0x74, 0xb7, 0xf1, 0xac, 0x1d, 0x99, 0x4a, 0x6e, 0x2e, 0xb3, 0xf, 0xa9, 0xc3,
        0xae, 0xf0, 0x82, 0x88, 0x7b, 0xba, 0x1d, 0xde, 0x72, 0x6e, 0xc3, 0xf9, 0xc7, 0xae, 0xcb, 0xa3, 0x89, 0xd1, 0x52, 0xe, 0x79, 0x72, 0x91, 0x7f, 0xb,
        0x14, 0xa7, 0xd5,
    ]);
    assert_eq(
        key.recover([
            0x7d, 0x62, 0x7b, 0xf9, 0xbd, 0x9f, 0x64, 0x2e, 0x3d, 0x64, 0xa0, 0xd9, 0x77, 0x1f, 0x1, 0xc, 0xa1, 0x6c, 0x45, 0x6a, 0xb5, 0x4f, 0x68, 0xc0, 0xc0,
