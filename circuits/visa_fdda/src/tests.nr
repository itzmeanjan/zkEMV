//! End-to-end tests on a synthetic Visa tap with the structure of the real cards.
//! `tests/vectors.nr` is generated by `scripts/gen_circuit_inputs.py` from `fixtures/visa_fdda.json`.

mod vectors;

use crate::verify;
use emv::{BinMembership, nullifier};
use vectors::{CARDS, ICC_MODULUS};

#[test]
fn every_card_verifies() {
    for i in 0..CARDS.len() {
        let _ = verify(CARDS[i]);
    }
}

#[test]
fn nullifier_is_of_the_certified_icc_key() {
    assert_eq(verify(CARDS[0]).1, nullifier(ICC_MODULUS, CARDS[0].scope));
}

#[test]
fn nullifier_changes_with_scope() {
    let mut x = CARDS[0];
    x.scope += 1;
    assert(verify(x).1 != verify(CARDS[0]).1);
}

/// `scripts/gen_synthetic.py`'s `BIN_ATTRIBUTES`: credit, VISA.
#[test]
fn discloses_the_cards_bin_attributes() {
    let (a, _) = verify(CARDS[0]);
    assert_eq((a.country, a.card_type, a.brand, a.commercial), (999, 1, 2, false));
}

#[test]
fn nothing_disclosed_needs_no_bin_table() {
    let mut x = CARDS[0];
    x.disclose = 0;
    x.bin_root = 0;
    x.bin = BinMembership { low: 0, high: 0, country: 0, card_type: 0, brand: 0, commercial: false, slot: 0, siblings: [0; 24] };
    let (a, n) = verify(x);
    assert_eq((a.country, a.card_type, a.brand, a.commercial), (0, 0, 0, false));
    assert_eq(n, verify(CARDS[0]).1);
}

#[test(should_fail_with = "range is not in the BIN table")]
fn wrong_bin_root_fails() {
    let mut x = CARDS[0];
    x.bin_root += 1;
    let _ = verify(x);
}

#[test(should_fail_with = "range is not in the BIN table")]
fn changed_bin_attribute_fails() {
    let mut x = CARDS[0];
    x.bin.commercial = !x.bin.commercial;
    let _ = verify(x);
}

#[test(should_fail)]
fn range_without_the_pan_fails() {
    // The PAN's prefix is its range's low, so this excludes it; the leaf changes too.
    let mut x = CARDS[0];
    x.bin.low += 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_nonce_fails() {
    let mut x = CARDS[0];
    x.nonce[3] ^= 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_amount_fails() {
    let mut x = CARDS[0];
    x.amount[5] ^= 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_currency_fails() {
    let mut x = CARDS[0];
    x.currency[1] ^= 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_card_auth_data_fails() {
    let mut x = CARDS[0];
    x.card_auth_data[1] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_dynamic_signature_fails() {
    let mut x = CARDS[0];
    x.sdad[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_icc_certificate_fails() {
    let mut x = CARDS[0];
    x.icc_cert[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_issuer_certificate_fails() {
    let mut x = CARDS[0];
    x.issuer_cert[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn wrong_ca_key_fails() {
    let mut x = CARDS[0];
    x.ca_modulus[0] += 2;
    let _ = verify(x);
}

#[test(should_fail_with = "issuer exponent must be 3")]
fn wrong_issuer_exponent_fails() {
    let mut x = CARDS[0];
    x.issuer_exponent = 1;
    let _ = verify(x);
}

#[test(should_fail_with = "ICC exponent must be 3")]
fn wrong_icc_exponent_fails() {
    let mut x = CARDS[0];
    x.icc_exponent = 1;
    let _ = verify(x);
}

#[test(should_fail_with = "certificate expired")]
fn expired_fails() {
    let mut x = CARDS[0];
    x.today = 5001;
    let _ = verify(x);
}
