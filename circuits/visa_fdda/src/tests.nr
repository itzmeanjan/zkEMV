//! End-to-end tests on synthetic Visa taps with the structure of the real cards.
//! `tests/vectors.nr` is generated by `scripts/gen_circuit_inputs.py` from `fixtures/`:
//! `CARDS[0]` is `visa_fdda.json` (no static data, SDAD format 95), `CARDS[1]` is
//! `visa_fdda_oda.json` (an ODA record and the AIP as static data, SDAD format 05).

mod vectors;

use crate::verify;
use emv::nullifier;
use vectors::{CARDS, ICC_MODULI};

#[test]
fn every_card_verifies() {
    for i in 0..CARDS.len() {
        let _ = verify(CARDS[i]);
    }
}

#[test]
fn nullifier_is_of_the_certified_icc_key() {
    for i in 0..CARDS.len() {
        assert_eq(verify(CARDS[i]), nullifier(ICC_MODULI[i], CARDS[i].scope));
    }
}

#[test]
fn nullifier_changes_with_scope() {
    let mut x = CARDS[0];
    x.scope += 1;
    assert(verify(x) != verify(CARDS[0]));
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_nonce_fails() {
    let mut x = CARDS[0];
    x.nonce[3] ^= 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_amount_fails() {
    let mut x = CARDS[0];
    x.amount[5] ^= 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_currency_fails() {
    let mut x = CARDS[0];
    x.currency[1] ^= 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_card_auth_data_fails() {
    let mut x = CARDS[0];
    x.card_auth_data[1] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_dynamic_signature_fails() {
    let mut x = CARDS[0];
    x.sdad[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_icc_certificate_fails() {
    let mut x = CARDS[0];
    x.icc_cert[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_issuer_certificate_fails() {
    let mut x = CARDS[0];
    x.issuer_cert[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn wrong_ca_key_fails() {
    let mut x = CARDS[0];
    x.ca_modulus[0] += 2;
    let _ = verify(x);
}

#[test(should_fail_with = "issuer exponent must be 3")]
fn wrong_issuer_exponent_fails() {
    let mut x = CARDS[0];
    x.issuer_exponent = 1;
    let _ = verify(x);
}

#[test(should_fail_with = "ICC exponent must be 3")]
fn wrong_icc_exponent_fails() {
    let mut x = CARDS[0];
    x.icc_exponent = 1;
    let _ = verify(x);
}

#[test(should_fail_with = "certificate expired")]
fn expired_fails() {
    let mut x = CARDS[0];
    x.today = 5001;
    let _ = verify(x);
}

#[test]
fn cards_cover_both_static_data_and_formats() {
    assert_eq(CARDS[0].static_data.len(), 0);
    assert(CARDS[1].static_data.len() > 0);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn tampered_static_data_fails() {
    let mut x = CARDS[1];
    x.static_data.set(0, x.static_data.get(0) ^ 1);
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn dropped_static_data_fails() {
    let mut x = CARDS[1];
    let _ = x.static_data.pop();
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn static_data_on_a_card_without_any_fails() {
    let mut x = CARDS[0];
    x.static_data.push(0x82);
    let _ = verify(x);
}
