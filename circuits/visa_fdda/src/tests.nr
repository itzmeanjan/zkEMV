//! End-to-end tests on a synthetic Visa tap with the structure of the real cards.
//! `tests/vectors.nr` is generated by `scripts/gen_circuit_inputs.py` from `fixtures/visa_fdda.json`.

mod vectors;

use crate::main;
use emv::{BinMembership, nullifier};
use vectors::{BIN_MEMBERSHIP, CARD, CHALLENGE, ICC_MODULUS, TRANSACTION, TRUST_ANCHORS};

#[test]
fn synthetic_tap_verifies() {
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, CARD, BIN_MEMBERSHIP);
}

#[test]
fn nullifier_is_of_the_certified_icc_key() {
    assert_eq(main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, CARD, BIN_MEMBERSHIP).nullifier, nullifier(ICC_MODULUS, CHALLENGE.scope));
}

#[test]
fn nullifier_changes_with_scope() {
    let mut challenge = CHALLENGE;
    challenge.scope += 1;
    assert(
        main(TRUST_ANCHORS, challenge, TRANSACTION, CARD, BIN_MEMBERSHIP).nullifier
            != main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, CARD, BIN_MEMBERSHIP).nullifier,
    );
}

/// `scripts/gen_synthetic.py`'s `BIN_ATTRIBUTES`: credit, VISA.
#[test]
fn discloses_the_cards_bin_attributes() {
    let a = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, CARD, BIN_MEMBERSHIP).bin_attributes;
    assert_eq((a.country, a.card_type, a.brand, a.commercial), (999, 1, 2, false));
}

#[test]
fn nothing_disclosed_needs_no_bin_table() {
    let (mut trust_anchors, mut challenge) = (TRUST_ANCHORS, CHALLENGE);
    challenge.disclosure = 0;
    trust_anchors.bin_root = 0;
    let no_bin = BinMembership { low: 0, high: 0, country: 0, card_type: 0, brand: 0, commercial: false, slot: 0, siblings: [0; 24] };
    let revealed = main(trust_anchors, challenge, TRANSACTION, CARD, no_bin);
    let a = revealed.bin_attributes;
    assert_eq((a.country, a.card_type, a.brand, a.commercial), (0, 0, 0, false));
    assert_eq(revealed.nullifier, main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, CARD, BIN_MEMBERSHIP).nullifier);
}

#[test(should_fail_with = "range is not in the BIN table")]
fn wrong_bin_root_fails() {
    let mut trust_anchors = TRUST_ANCHORS;
    trust_anchors.bin_root += 1;
    let _ = main(trust_anchors, CHALLENGE, TRANSACTION, CARD, BIN_MEMBERSHIP);
}

#[test(should_fail_with = "range is not in the BIN table")]
fn changed_bin_attribute_fails() {
    let mut bin_membership = BIN_MEMBERSHIP;
    bin_membership.commercial = !bin_membership.commercial;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, CARD, bin_membership);
}

#[test(should_fail)]
fn range_without_the_pan_fails() {
    // The PAN's prefix is its range's low, so this excludes it; the leaf changes too.
    let mut bin_membership = BIN_MEMBERSHIP;
    bin_membership.low += 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, CARD, bin_membership);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_nonce_fails() {
    let mut challenge = CHALLENGE;
    challenge.nonce[3] ^= 1;
    let _ = main(TRUST_ANCHORS, challenge, TRANSACTION, CARD, BIN_MEMBERSHIP);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_amount_fails() {
    let mut transaction = TRANSACTION;
    transaction.amount_authorised[5] ^= 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, transaction, CARD, BIN_MEMBERSHIP);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_currency_fails() {
    let mut transaction = TRANSACTION;
    transaction.currency_code[1] ^= 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, transaction, CARD, BIN_MEMBERSHIP);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_card_auth_related_data_fails() {
    let mut card = CARD;
    card.card_auth_related_data[1] ^= 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, card, BIN_MEMBERSHIP);
}

#[test(should_fail)]
fn tampered_signed_dynamic_app_data_fails() {
    let mut card = CARD;
    card.signed_dynamic_app_data[64] ^= 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, card, BIN_MEMBERSHIP);
}

#[test(should_fail)]
fn tampered_icc_pubkey_cert_fails() {
    let mut card = CARD;
    card.icc_pubkey_cert[64] ^= 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, card, BIN_MEMBERSHIP);
}

#[test(should_fail)]
fn tampered_issuer_pubkey_cert_fails() {
    let mut card = CARD;
    card.issuer_pubkey_cert[64] ^= 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, card, BIN_MEMBERSHIP);
}

#[test(should_fail)]
fn wrong_ca_key_fails() {
    let mut trust_anchors = TRUST_ANCHORS;
    trust_anchors.ca_modulus[0] += 2;
    let _ = main(trust_anchors, CHALLENGE, TRANSACTION, CARD, BIN_MEMBERSHIP);
}

#[test(should_fail_with = "issuer exponent must be 3")]
fn wrong_issuer_pubkey_exponent_fails() {
    let mut card = CARD;
    card.issuer_pubkey_exponent = 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, card, BIN_MEMBERSHIP);
}

#[test(should_fail_with = "ICC exponent must be 3")]
fn wrong_icc_pubkey_exponent_fails() {
    let mut card = CARD;
    card.icc_pubkey_exponent = 1;
    let _ = main(TRUST_ANCHORS, CHALLENGE, TRANSACTION, card, BIN_MEMBERSHIP);
}

#[test(should_fail_with = "certificate expired")]
fn expired_fails() {
    let mut challenge = CHALLENGE;
    challenge.today_yymm = 5001;
    let _ = main(TRUST_ANCHORS, challenge, TRANSACTION, CARD, BIN_MEMBERSHIP);
}
