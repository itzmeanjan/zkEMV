//! End-to-end tests on a synthetic Mastercard tap with the structure of the real cards.
//! `tests/vectors.nr` is generated by `scripts/gen_circuit_inputs.py` from `fixtures/mastercard_dda.json`.

mod vectors;

use crate::verify;
use emv::nullifier;
use vectors::{CARDS, ICC_MODULUS};

#[test]
fn every_card_verifies() {
    for i in 0..CARDS.len() {
        let _ = verify(CARDS[i]);
    }
}

#[test]
fn nullifier_is_of_the_certified_icc_key() {
    assert_eq(verify(CARDS[0]), nullifier(ICC_MODULUS, CARDS[0].scope));
}

#[test]
fn nullifier_changes_with_scope() {
    let mut x = CARDS[0];
    x.scope += 1;
    assert(verify(x) != verify(CARDS[0]));
}

#[test(should_fail_with = "recovered hash mismatch")]
fn wrong_nonce_fails() {
    let mut x = CARDS[0];
    x.nonce[3] ^= 1;
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn tampered_static_data_fails() {
    let mut x = CARDS[0];
    let b = x.static_data.get(10);
    x.static_data.set(10, b ^ 1);
    let _ = verify(x);
}

#[test(should_fail_with = "recovered hash mismatch")]
fn truncated_static_data_fails() {
    let mut x = CARDS[0];
    let _ = x.static_data.pop();
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_issuer_remainder_fails() {
    // The remainder is covered by the issuer certificate hash, and it is also the tail
    // of the issuer key; either check catches it.
    let mut x = CARDS[0];
    x.issuer_remainder[5] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_dynamic_signature_fails() {
    let mut x = CARDS[0];
    x.sdad[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_icc_certificate_fails() {
    let mut x = CARDS[0];
    x.icc_cert[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn tampered_issuer_certificate_fails() {
    let mut x = CARDS[0];
    x.issuer_cert[64] ^= 1;
    let _ = verify(x);
}

#[test(should_fail)]
fn wrong_ca_key_fails() {
    let mut x = CARDS[0];
    x.ca_modulus[0] ^= 2;
    let _ = verify(x);
}

#[test(should_fail_with = "certificate expired")]
fn expired_fails() {
    let mut x = CARDS[0];
    x.today = 5001;
    let _ = verify(x);
}
